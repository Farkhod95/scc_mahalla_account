# Nusxa oling: cp .env.example .env  va haqiqiy qiymatlarni to'ldiring.
# docker-compose.yml dagi mahalla_account/celery/celery-beat servislariga
# (env_file: .env) uzatiladi.

# Raqamli bozor (scc_raqamli_bozor) statik token — ikkala yo'nalishda ham
# shu qiymat ishlatiladi:
#   - raqamli_bozor -> Malika bozor: X-Api-Key header (restapp.authentication.StaticTokenAuthentication)
#   - Malika bozor -> raqamli_bozor: reports/views/raqamli_bozor_proxy.py RAQAMLI_BOZOR_STATIC_TOKEN (alohida token)
MALIKA_PROXY_STATIC_TOKEN=

# Malika bozor -> raqamli_bozor proxy (reports/views/raqamli_bozor_proxy.py) uchun
RAQAMLI_BOZOR_BASE_URL=http://192.168.168.171:3000
RAQAMLI_BOZOR_STATIC_TOKEN=
